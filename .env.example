# Database (Neon Serverless PostgreSQL)
# Required only if you wish to persist dynamic projects to Neon.
# If unset, the app gracefully falls back to the curated default projects.
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Vercel Blob Storage
# Required for uploading blog images via the admin CMS.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_sample_token

# Admin Security
# Passcode required to unlock the /admin dashboard. Default: admin123
NEXT_PUBLIC_ADMIN_PASSCODE=admin123
