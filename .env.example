# Database (Neon Serverless PostgreSQL)
# Required only if you wish to persist dynamic projects to Neon.
# If unset, the app gracefully falls back to the curated default projects.
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Vercel Blob Storage
# Required for uploading blog images via the admin CMS.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_sample_token

# Admin Security
# Passcode required to unlock the /admin dashboard. Default: admin123
NEXT_PUBLIC_ADMIN_PASSCODE=admin123
ADMIN_PASSCODE=admin123

# Local Prospect Discovery & Audit Engine (local CLI only; never exposed to client)
GOOGLE_MAPS_API_KEY=your_google_places_api_key
GOOGLE_MAPS_API_KEY_2=your_google_places_api_key_2
WEB2WAVE_API_KEY_1=your_web2wave_project_key_1
WEB2WAVE_API_KEY_2=your_web2wave_project_key_2
APIFY_API_TOKEN=optional_apify_token_off_by_default

